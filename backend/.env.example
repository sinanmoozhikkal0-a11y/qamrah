# QAMRAH Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/qamrah?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/qamrah
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/qamrah?retryWrites=true&w=majority

# JWT Secret for Authentication
JWT_SECRET=your_jwt_secret_key_luxury_qamrah_2026

# Admin Seed Account (Configured via Environment Variables)
ADMIN_NAME=your_admin_username
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password
